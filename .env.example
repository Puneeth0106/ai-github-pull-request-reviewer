# Copy to .env and replace placeholders. Compose injects these as environment
# variables; do not copy the combined .env into individual service directories.
POSTGRES_USER=reviewer
POSTGRES_PASSWORD=replace-with-local-database-password
POSTGRES_DB=codereviewer
# Match POSTGRES_PASSWORD above. URL-encode special characters in DATABASE_URL.
DATABASE_URL=postgresql+asyncpg://reviewer:replace-with-local-database-password@postgres:5432/codereviewer
REDIS_URL=redis://redis:6379/0

GITHUB_WEBHOOK_SECRET=replace-with-random-webhook-secret
GITHUB_APP_ID=replace-with-github-app-id
# One line, with literal \n between PEM lines. Do not commit a real private key.
GITHUB_APP_PRIVATE_KEY=replace-with-github-app-private-key
OPENAI_API_KEY=replace-with-openai-api-key

# Optional tracing. Keep disabled until valid Langfuse credentials are set.
LANGFUSE_TRACING_ENABLED=false
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://us.cloud.langfuse.com
